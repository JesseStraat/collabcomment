% \section{Documentation}
% This is the documentation of \pkg{collabcomment}, a package which
% improves leaving comments for collaborators. The basic functionalities
% are the following.
% \begin{itemize}
%   \item Leave coloured comments and to-dos in your \LaTeX{} document.
%   \item Create custom authors with their own colour.
%   \item Comments and to-dos are numbered and fully compatible with \pkg{hyperref}.
%   \item Collect all to-dos/comments into a hyperlinked list grouped by author.
%   \item Use the |final| package option to get rid of all comments and lists.
%   \item Mark to-dos as complete to remove them from the text, but still
%   appear in the to-do list.
% \end{itemize}
% 
%^^A
% \subsection{Usage}
% The basic functionality of this package is in writing notes and to-dos (together called comments).\par
% \DescribeOption{final}
% When the |final| option is set, comments, comment lists and author lists are
% not displayed in the PDF file. Use this for ``final versions'', which shouldn't
% have any of these.
% \begin{function}{\note}
%   \begin{syntax}
%       \tn{note}\oarg{author}\textlangle\meta{keyvals}\textrangle\Arg{text}
%   \end{syntax}
%   Creates a note at the current position. The \meta{author} parameter should reflect the name of whoever
%   is writing the comment. For example, |\note[John Smith]{Foo}| gives \note[John Smith]{Foo}.
%   The only keyvals currently supported are |margin|, which puts the comment in the margin,
%   and |footnote|, which puts the comment in a footnote.
%   For example, |\note[Joe Shmoe]<margin>{Bar}|
%   creates the comment currently in the margins. If no author is given, the system uses
%   |default| as the author.\par
%   Comments are compatible with math mode; for example,
%   \begin{equation}
%       E = \note[John Smith]{\gamma}mc^2.
%   \end{equation}
% \end{function}
% \note[Joe Shmoe]<margin>{Bar}
% \begin{function}{\todo,\todo*}
%   \begin{syntax}
%       \tn{todo}\oarg{author}\textlangle\meta{keyvals}\textrangle\Arg{text}
%       \tn{todo*}\oarg{author}\textlangle\meta{keyvals}\textrangle\Arg{text}
%   \end{syntax}
%   Creates a to-do at the current position. Behaves in the exact same way as \tn{note}, except
%   ``Todo:'' is added in front of the note, and \tn{todo*} marks the to-do as completed, which
%   will prevent the to-do from being displayed in the text, while keeping it in the to-do list.
%   For example, |\todo[John Smith]{Baz}| gives \todo[John Smith]{Baz}\label{comment:bar}.
%   \todo*[John Smith]{This to-do has been completed.}
% \end{function}
% Each comment starts with a counter, the |collabcomment| counter. They are
% also compatible with \pkg{hyperref}, so one can reference them as \autoref{comment:bar}.
% To make comment lists work, each comment is labeled by default as
% |collabcomment:[counter]|. It is not advised to
% use these labels as an end user, since they may change if other comments
% are added. Instead, define your own labels using another naming
% scheme.
% \begin{function}{\createauthor}
%   \begin{syntax}
%       \tn{createauthor}\Arg{name}{colour}
%   \end{syntax}
%   Gives all comments by author \meta{name} a custom colours, \meta{colour}. For example,
%   if we use |\createauthor{Jane Doe}{violet}|\createauthor{Jane Doe}{violet},
%   then |\note{Jane Doe}{Foobar}| gives \note[Jane Doe]{Foobar}. Any \pkg{xcolor}
%   colour can be used for this.
% \end{function}
% \begin{function}{\listauthors}
%   \begin{syntax}
%       \tn{listauthors}
%   \end{syntax}
%   Displays all defined authors and their colours, for example:\par
%   \listauthors
% \end{function}
% \begin{function}{\notelist,\notelist*}
%   \begin{syntax}
%       \tn{notelist}
%       \tn{notelist*}
%   \end{syntax}
%   Creates a hyperlinked list of all notes, grouped by author. It's
%   wrapped in an unnumbered section/chapter, which is added to the table
%   of contents. The starred version outputs just the list, without a
%   new section.
% \end{function}
% \begin{function}{\todolist,\todolist*}
%   \begin{syntax}
%       \tn{todolist}
%       \tn{todolist*}
%   \end{syntax}
%   Creates a hyperlinked list of all to-dos, grouped by author. All completed to-dos
%   are greyed out, and the hyperlink points to the place where the to-do would have been.
% \end{function}
% 
% \notelist\todolist
% 
%
%
%
% \clearpage
% \section{Source code}
% This section contains the source code of the library.
% It contains some explaining descriptions, allowing for
% \href{https://https://en.wikipedia.org/wiki/Literate_programming}{literate programming}.
% This is where the documentation for ``regular people'' ends.
%^^A
%^^A
%^^A
%^^A
% \setcounter{CodelineNo}{0}
%    \begin{macrocode}
%<*main>
%<@@=collabcomment>
\ProvidesPackage{collabcomment}[2026/06/09 v1.0 Collaborative comments]
\RequirePackage{xcolor}
\RequirePackage{xparse,l3keys2e}
\ExplSyntaxOn
%    \end{macrocode}
% \begin{variable}{\@@_prop_authorcolours,\@@_prop_comment_list,\@@_prop_todo_list,\@@_bool_final}
% Some variables to save relevant data to.
%    \begin{macrocode}
\prop_new:N \@@_prop_authorcolours
\prop_set_from_keyval:Nn \@@_prop_author_colours {
    default = red
}
\prop_new:N \@@_prop_comment_list
\prop_new:N \@@_prop_todo_list
\bool_new:N \@@_bool_final
\newcounter{collabcomment}
\providecommand{\theHcollabcomment}{\arabic{collabcomment}}
\providecommand*{\collabcommentautorefname}{Comment}
%    \end{macrocode}
% \end{variable}
% The following are the package settings.
%    \begin{macrocode}
\keys_define:nn {collabcomment} {
    final .bool_set:N = \@@_bool_final
}
\ProcessKeysOptions {collabcomment}
%    \end{macrocode}
% We also set up the keyval settings for comments and to-dos.
%    \begin{macrocode}
\keys_define:nn {commentposition} {
    margin .bool_set:N = \l_tmpa_bool,
    footnote .bool_set:N = \l_tmpb_bool,
}
%    \end{macrocode}
% \begin{macro}{\note}
% Creates a note.
%    \begin{macrocode}
\NewDocumentCommand{\note}{ O{default} D<>{} +m }{
    \@@_parse_reference:
    \@@_parse_keyvals:nn {#2} {
        \@@_make_comment:nn {#1} {#3}
    }
    \@@_prop_add_to:Nnn
        \@@_prop_comment_list {#1} {#3}
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\todo}
% Creates a to-do.
%    \begin{macrocode}
\NewDocumentCommand{\todo}{ s O{default} D<>{} +m }{
    \@@_parse_reference:
    \IfBooleanF{#1}{
%    \end{macrocode}
% To-do isn't done yet: display it as normal.
%    \begin{macrocode}
        \@@_parse_keyvals:nn {#3} {
            \@@_make_comment:nn {#2} {
                \textbf{Todo:~}#4
            }
        }
    }
    \@@_prop_add_to:Nnnnn \@@_prop_todo_list {#2}
        {#4}
%    \end{macrocode}
% While \pkg{hyperref} is fully compatible with putting colours inside
% hyperlinks, \pkg{ocgx2}'s |ocgcolorlinks| will override it with the
% default link colour. To fix this, we need to reset the |linkcolor| in
% a hook to actually adding the new entry.
%    \begin{macrocode}
        {\group_begin:
        \IfBooleanT{#1}{\hypersetup{linkcolor=.}\color{lightgray}}}
        {\group_end:}
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\createauthor}
% Create a new author with corresponding colour.
%    \begin{macrocode}
\NewDocumentCommand{\createauthor}{ m m }{
    \prop_gput:Nnn \@@_prop_author_colours {#1} {#2}
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\listauthors}
% Displays a list of all authors.
%    \begin{macrocode}
\NewDocumentCommand{\listauthors}{}{
    \@@_parse_keyvals:nn {} {
    List~of~authors:
    \begin{itemize}
        \prop_map_inline:Nn \@@_prop_author_colours {
            \item
            \begingroup
            \color{##2}
            ##1:~##2\par
            \endgroup
        }
    \end{itemize}
    }
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\notelist}
% Displays a list of all notes, grouped by author.
%    \begin{macrocode}
\NewDocumentCommand{\notelist}{ s }{
    \IfBooleanF{#1}{
        \@@_list_section:n {List~of~notes}
    }
    \@@_display_list:N \@@_prop_comment_list
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\todolist}
% Displays a list of all to-dos, grouped by author.
%    \begin{macrocode}
\NewDocumentCommand{\todolist}{ s }{
    \IfBooleanF{#1}{
        \@@_list_section:n {List~of~to-dos}
    }
    \@@_display_list:N \@@_prop_todo_list
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_check_if_final:n}
% Checks if the document is in draft (default) or final mode. If in draft mode,
% it returns its input, while in final mode, it returns nothing.
%    \begin{macrocode}
\cs_new:Nn \@@_check_if_final:n {
    \bool_if:NF \@@_bool_final {#1}
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_make_comment:nn}
% Creates a comment in the right colour, with a counter.
%    \begin{macrocode}
\cs_new:Nn \@@_make_comment:nn {
    \begingroup
    \color{\@@_get_author_colour:n{#1}}
    \textbf{\thecollabcomment.~}#2
    \endgroup
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_get_author_colour:n}
% Gets the colour saved to some author.
%    \begin{macrocode}
\cs_new:Nn \@@_get_author_colour:n {
    \prop_if_in:NnTF \@@_prop_author_colours {#1} {
        \prop_item:Nn \@@_prop_author_colours {#1}
    }{
        \prop_item:Nn \@@_prop_author_colours {default}
    }
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_prop_add_to:Nnnnn,\@@_prop_add_to:Nnn}
% Adds a comment to one of the comment lists, grouped by author.
%    \begin{macrocode}
\cs_new:Nn \@@_prop_add_to:Nnnnn {
    \tl_set:Ne \l_tmpa_tl {\prop_item:Nn #1 {#2}}
    \tl_put_right:Nn \l_tmpa_tl {\item}
    \tl_put_right:Ne \l_tmpa_tl {[\thecollabcomment.]}
%    \end{macrocode}
% The following is an optional hook.
%    \begin{macrocode}
    \tl_put_right:Nn \l_tmpa_tl {#4}
%    \end{macrocode}
% If we're in math mode, we should add |\(...\)| around the comment.
%    \begin{macrocode}
    \ifmmode \tl_put_right:Nn \l_tmpa_tl {\(}\fi
%    \end{macrocode}
% If |\hyperref| is defined, we wrap the entire comment into a |\hyperref| towards
% the comment.
%    \begin{macrocode}
    \@@_href_put_right:Nn \l_tmpa_tl {
        collabcomment:\thecollabcomment
    }
    \tl_put_right:Nn \l_tmpa_tl { {#3} }
    \ifmmode \tl_put_right:Nn \l_tmpa_tl {\)}\fi
    \tl_put_right:Nn \l_tmpa_tl {#5}
    \prop_gput:NnV #1 {#2} \l_tmpa_tl
}
%    \end{macrocode}
% We also define a simplified version without the hook.
%    \begin{macrocode}
\cs_new:Nn \@@_prop_add_to:Nnn {
    \@@_prop_add_to:Nnnnn #1 {#2} {#3} {} {}
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_display_list:N}
% Displays a comment list, grouped by author.
%    \begin{macrocode}
\cs_new:Nn \@@_display_list:N {
    \@@_check_if_final:n {
        \prop_map_inline:Nn #1 {
            \tl_set:Nn \l_tmpa_tl {##2}
            \tl_if_empty:NF \l_tmpa_tl {
                {
                    \large
                    \color{\@@_get_author_colour:n {##1}}
                    ##1:
                }
                \begin{itemize}
                ##2
                \end{itemize}
            }
        }
    }
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_list_section:n}
% Creates an unnumbered top-level section and puts it in the table
% of contents.
%    \begin{macrocode}
\cs_new:Nn \@@_list_section:n {
    \@@_check_if_final:n {
        \ifcsname chapter\endcsname
            \chapter*{#1}
            \addcontentsline{toc}{chapter}{#1}
        \else
            \section*{#1}
            \addcontentsline{toc}{section}{#1}
        \fi
    }
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_parse_keyvals:nn}
% Parses the keyvals and package options. In particular, it doesn't display
% anything if final mode is active, and puts comments in the margins or footnotes
% if needed.
%    \begin{macrocode}
\cs_new:Nn \@@_parse_keyvals:nn {
    \@@_check_if_final:n {
        \group_begin:
            \keys_set:nn {commentposition} {#1}
            \bool_if:NTF {\l_tmpa_bool} {
                % Margin option
                \marginpar{#2}
            }{
            \bool_if:NTF {\l_tmpb_bool} {
                % Footnote
                \footnote{#2}
            }{
                % No option
                #2
            }}
        \group_end:
    }
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_parse_reference:}
% Creates a reference, increases the counter, and labels the reference for internal use.
%    \begin{macrocode}
\cs_new:Nn \@@_parse_reference: {
    \refstepcounter{collabcomment}
    \label{collabcomment:\thecollabcomment}
}
%    \end{macrocode}
% \end{macro}\begin{macro}{\@@_href_put_right:Nn}
% A variant on |tl_put_right:Nn|, where, if |\hyperref| is defined, a reference to some
% reference key is added.
%    \begin{macrocode}
\cs_new:Nn \@@_href_put_right:Nn {
    \ifcsname hyperref\endcsname
        \tl_put_right:Nn #1 {\hyperref}
        \tl_put_right:Ne #1 {[#2]}
    \fi
}
%    \end{macrocode}
% \end{macro}
%    \begin{macrocode}
\ExplSyntaxOff
%</main>
%    \end{macrocode}
% \Finale